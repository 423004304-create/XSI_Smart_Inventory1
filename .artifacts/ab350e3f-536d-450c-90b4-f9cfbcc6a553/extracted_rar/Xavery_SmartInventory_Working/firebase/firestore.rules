rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Legacy role names remain recognized until existing profiles are migrated.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['Project Admin', 'Admin', 'Project Administrator', 'Administrator'];
    }
    function isProjectAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['Project Admin', 'Project Administrator'];
    }
    function isEmployee() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['Staff', 'Inventory Clerk', 'Sales Staff'];
    }
    function isSalesStaff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == 'Sales Staff';
    }
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role'])
        && request.resource.data.role == 'Staff'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp);
      allow update: if (isProjectAdmin()
          && request.resource.data.role in ['Staff', 'Sales Staff', 'Admin', 'Project Admin']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
        || (isAdmin()
          && resource.data.role in ['Staff', 'Sales Staff', 'Inventory Clerk']
          && request.resource.data.role in ['Staff', 'Sales Staff']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
        || (signedIn()
          && request.auth.uid == userId
          && resource.data.role != 'Project Admin'
          && resource.data.role != 'Project Administrator'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']));
      allow delete: if resource.data.role != 'Project Admin'
        && resource.data.role != 'Project Administrator'
        && (isProjectAdmin() || (signedIn() && request.auth.uid == userId));
    }
    match /products/{productId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSalesStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0);
    }
    match /movements/{movementId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /attendance/{attendanceId} {
      allow get: if isEmployee()
        && (!exists(/databases/$(database)/documents/attendance/$(attendanceId))
          || resource.data.employeeId == request.auth.uid);
      allow list: if isEmployee()
        && resource.data.employeeId == request.auth.uid;
      allow create: if isEmployee()
        && attendanceId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly([
          'employeeId', 'employeeName', 'date', 'timeIn', 'timeOut'
        ])
        && request.resource.data.keys().hasAll([
          'employeeId', 'employeeName', 'date', 'timeIn', 'timeOut'
        ])
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.employeeName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.timeIn == request.time
        && request.resource.data.timeOut == null;
      allow update: if isEmployee()
        && resource.data.employeeId == request.auth.uid
        && attendanceId == request.auth.uid + '_' + resource.data.date
        && resource.data.timeOut == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeOut'])
        && request.resource.data.timeOut == request.time;
      allow delete: if false;
    }
    match /reports/{reportId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /invites/{inviteId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.role in ['Staff', 'Admin', 'Project Admin'];
    }
  }
}
