<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:src="@drawable/xavery_logo"
                    android:contentDescription="Xavery Logo"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good morning, LeBron"
                        android:textColor="#151515"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Tuesday, June 2, 2026"
                        android:textColor="#777777"
                        android:textSize="9sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/addProductButton"
                    android:layout_width="98dp"
                    android:layout_height="34dp"
                    android:background="@drawable/dashboard_outline_button"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="⊞  Add product"
                    android:textAllCaps="false"
                    android:textColor="#222222"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_marginStart="13dp"
                    android:background="@drawable/profile_circle_background"
                    android:gravity="center"
                    android:text="LJ"
                    android:textColor="#1267AA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- STATISTIC CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="143dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="46dp"
                android:layout_marginEnd="22dp"
                android:orientation="horizontal">

                <!-- TOTAL PRODUCTS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="143dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/dashboard_card_background"
                    android:orientation="vertical"
                    android:padding="9dp">

                    <TextView
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:background="@drawable/icon_blue_circle"
                        android:gravity="center"
                        android:text="⬡"
                        android:textColor="#1767B1"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Total products"
                        android:textColor="#666666"
                        android:textSize="9sp"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="1,284"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="19dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/status_yellow_background"
                        android:gravity="center"
                        android:text="+12%"
                        android:textColor="#955A00"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- REVENUE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="143dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/dashboard_card_background"
                    android:orientation="vertical"
                    android:padding="9dp">

                    <TextView
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:background="@drawable/icon_red_circle"
                        android:gravity="center"
                        android:text="↗"
                        android:textColor="#C83232"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Revenue (Mo.)"
                        android:textColor="#666666"
                        android:textSize="9sp"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="₱67,000"
                        android:textColor="#111111"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="19dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/status_yellow_background"
                        android:gravity="center"
                        android:text="+8%"
                        android:textColor="#955A00"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- TOTAL SALES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="143dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/dashboard_card_background"
                    android:orientation="vertical"
                    android:padding="9dp">

                    <TextView
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:background="@drawable/icon_orange_circle"
                        android:gravity="center"
                        android:text="🛒"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Total sales"
                        android:textColor="#666666"
                        android:textSize="9sp"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="892"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="19dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/status_red_background"
                        android:gravity="center"
                        android:text="+12%"
                        android:textColor="#C83232"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- LOW STOCK -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="143dp"
                    android:layout_weight="1"
                    android:background="@drawable/dashboard_card_background"
                    android:orientation="vertical"
                    android:padding="9dp">

                    <TextView
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:background="@drawable/icon_light_red_circle"
                        android:gravity="center"
                        android:text="⚠"
                        android:textColor="#C83232"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Low stock"
                        android:textColor="#666666"
                        android:textSize="9sp"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="24"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="19dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/status_yellow_background"
                        android:gravity="center"
                        android:text="Critical"
                        android:textColor="#955A00"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- RECENT PRODUCTS TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent products"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/viewAllProductsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="#1267AA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PRODUCT TABLE -->
            <LinearLayout
                android:id="@+id/productsTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/dashboard_table_background"
                android:orientation="vertical"
                android:clipToOutline="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="39dp"
                    android:gravity="center_vertical"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.35"
                        android:text="Name"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:text="SKU"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".65"
                        android:text="Qty"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.05"
                        android:text="Status"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".75"
                        android:gravity="end"
                        android:text="Price"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD" />

                <!-- Kotlin adds the five product rows here -->
                <LinearLayout
                    android:id="@+id/productRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ALERTS TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="8dp"
                    android:text="Alerts"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alertsViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="View all"
                    android:textColor="#1267AA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ALERTS TABLE -->
            <LinearLayout
                android:id="@+id/alertsTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/dashboard_table_background"
                android:orientation="vertical"
                android:clipToOutline="true" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/homeNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="49dp"
                android:layout_height="29dp"
                android:background="@drawable/home_selected_background"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#111111"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#111111"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inventoryNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:gravity="center"
                android:text="▤"
                android:textColor="#111111"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventory"
                android:textColor="#111111"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/addNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:gravity="center"
                android:text="⊕"
                android:textColor="#111111"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                android:textColor="#111111"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scanNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="#111111"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan"
                android:textColor="#111111"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alertsNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:gravity="center"
                android:text="♧"
                android:textColor="#111111"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerts"
                android:textColor="#111111"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:gravity="center"
                android:text="◎"
                android:textColor="#111111"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#111111"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
